DATABASE_URL=postgresql://catchsecu_app:CHANGE_ME@localhost:5432/catchsecu_dev
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
MAIL_TRANSPORT=local
MAIL_FROM=catchsecu@localhost.test
PRIVATE_STORAGE_DIR=.local/storage
FILE_STORAGE=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=catchsecu-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
CLAMAV_SOCKET=/absolute/path/to/private/clamd.sock
CLAMAV_MAX_SIGNATURE_AGE_HOURS=168
FILE_TENANT_QUOTA_BYTES=1073741824
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_SENDER_DOMAINS=mail.example.com
# EMAIL_FEEDBACK_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Enable only after HTTPS and the relay's DKIM coverage of both List-Unsubscribe headers are verified.
SMTP_LIST_UNSUBSCRIBE_DKIM_SIGNED=false
# SOLAPI_TENANT_ID=THE_COMPANY_UUID_BOUND_TO_THIS_PROVIDER_ACCOUNT
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SENDER_DNS_SERVER is reserved for localhost .test DNS fixtures; leave unset in deployment.
# Local transport writes private mail to .local/mail (never public/).

# 알림 시험은 로컬 파일에 기록한다. 실제 메신저 연결 시 webhook을 사용한다.
NOTIFICATION_TRANSPORT=local
LOCAL_NOTIFICATION_DIR=.local/notifications

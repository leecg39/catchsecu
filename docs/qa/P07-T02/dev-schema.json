  "triggers": [
    {
      "name": "certificate_marketing_copy_guard",
      "table": "DestructionCertificate",
      "definition": "CREATE TRIGGER certificate_marketing_copy_guard BEFORE INSERT ON public.\"DestructionCertificate\" FOR EACH ROW EXECUTE FUNCTION require_marketing_copy_erasure()"
    },
    {
      "name": "marketing_local_copy_guard",
      "table": "Job",
      "definition": "CREATE TRIGGER marketing_local_copy_guard BEFORE UPDATE ON public.\"Job\" FOR EACH ROW EXECUTE FUNCTION guard_marketing_local_copy()"
    }
  ],
  "functions": [
    {
      "name": "guard_marketing_local_copy",
      "definition": "CREATE OR REPLACE FUNCTION public.guard_marketing_local_copy()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF OLD.\"localCopyErasedAt\" IS NOT NULL AND NEW.\"localCopyErasedAt\" IS DISTINCT FROM OLD.\"localCopyErasedAt\"\n  THEN RAISE EXCEPTION 'local erasure evidence is immutable' USING ERRCODE='23514'; END IF;\n  RETURN NEW;\nEND $function$\n"
    },
    {
      "name": "require_marketing_copy_erasure",
      "definition": "CREATE OR REPLACE FUNCTION public.require_marketing_copy_erasure()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF EXISTS (SELECT 1 FROM \"Job\" WHERE \"marketingSubmissionId\"=NEW.\"submissionId\" AND \"localCopyErasedAt\" IS NULL)\n  THEN RAISE EXCEPTION 'certificate requires local delivery copy erasure' USING ERRCODE='23514'; END IF;\n  RETURN NEW;\nEND $function$\n"
    }
  ]
}

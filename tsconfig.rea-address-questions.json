{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/server/sso-transport.test.ts",
    "tests/server/sso.test.ts",
    "tests/server/sso-identity-proof.test.ts",
    "tests/helpers/sso-browser.ts",
    "scripts/qa-sso-transport-tls.ts",
    "scripts/qa-rea-sso-outbound.ts",
    "scripts/qa-rea-sso-browser-binding.ts",
    "scripts/qa-rea-sso-browser-fixture.ts",
    "scripts/qa-rea-sso-management.ts",
    "scripts/qa-rea-sso-session-proof.ts",
    "scripts/qa-rea-org-email.ts",
    "scripts/qa-rea-org-ticket.ts",
    "scripts/qa-sso-provider-management.ts",
    "scripts/qa-sso-provider-reference.ts",
    "scripts/qa-sso-provider-removal.ts",
    "scripts/qa-sso-provider-lifecycle.ts",
    "tests/server/sso-provider-tenant.test.ts",
    "tests/server/sso-management-crud.test.ts",
    "tests/server/sso-saml.test.ts",
    "tests/server/org-auth.test.ts",
    "tests/server/security-gate.test.ts",
    "scripts/qa-sso-https-environment.ts",
    "scripts/qa-rea-sso-https.ts",
    "scripts/qa-rea-sso-context.ts",
    "tests/server/history-guard.test.ts",
    "scripts/qa-rea-sso-journey.ts",
    "scripts/qa-rea-form-model.ts",
    "tests/server/form-current-authority.test.ts",
    "scripts/qa-rea-form-authority.ts",
    "tests/server/question-identities.test.ts",
    "tests/server/question-rules.test.ts",
    "scripts/qa-rea-option-migration.ts",
    "scripts/qa-rea-option-fresh.ts",
    "scripts/qa-rea-option-flow.ts",
    "tests/server/question-exact-selection.test.ts",
    "scripts/qa-rea-exact-flow.ts",
    "scripts/qa-rea-exact-migration.ts",
    "scripts/qa-rea-exact-fresh.ts",
    "tests/server/question-text-limits.test.ts",
    "scripts/qa-rea-text-migration.ts",
    "scripts/qa-rea-text-fresh.ts",
    "scripts/qa-rea-text-flow.ts",
    ".next-rea-address-questions/types/**/*.ts",
    ".next-rea-address-questions/dev/types/**/*.ts",
    "tests/server/question-special-types.test.ts",
    "tests/server/question-special-bindings.test.ts",
    "scripts/qa-rea-special-migration.ts",
    "scripts/qa-rea-special-fresh.ts",
    "scripts/qa-rea-special-flow.ts",
    "tests/server/question-address-types.test.ts",
    "scripts/qa-rea-address-migration.ts",
    "scripts/qa-rea-address-fresh.ts",
    "scripts/qa-rea-address-flow.ts"
  ],
  "exclude": [
    "node_modules",
    ".local",
    ".next",
    "docs"
  ]
}

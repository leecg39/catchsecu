{
  "name": "catchsecu-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/server.ts --dev",
    "build": "next build",
    "start": "node --import tsx scripts/server.ts",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "worker": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/worker.ts",
    "worker:exports": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/export-worker.ts",
    "test": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "verify:plan": "python3 scripts/verify-plan.py",
    "verify:route-baseline": "python3 scripts/verify-route-baseline.py",
    "verify:preflight": "node --env-file=.env.local --import tsx scripts/qa-preflight.ts",
    "verify:schema": "node --env-file=.env.local --import tsx scripts/verify-schema-contract.ts",
    "verify:api-audit": "node --import tsx scripts/audit-rea-api.ts",
    "verify:fixtures": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-route-fixtures.ts",
    "verify:p01-db": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-p01-db.ts",
    "verify:p01-api": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-p01-api.ts",
    "verify:s3": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-s3-storage.ts",
    "verify:outbox": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/with-shadow.ts scripts/verify-outbox.ts",
    "verify:mock": "node scripts/verify-mock.mjs",
    "verify:mock:providers": "node scripts/verify-mock.mjs --providers"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/env": "16.3.8",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@xmldom/xmldom": "0.8.15",
    "better-auth": "1.7.7",
    "bidi-js": "1.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "7.0.3",
    "fontkit": "2.0.4",
    "htmlparser2": "12.0.0",
    "linebreak": "1.1.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3",
    "xml-crypto": "^6.3.2"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
